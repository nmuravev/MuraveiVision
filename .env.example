# ── Настройки анализа видео ──
# Шаг кадров для обычного видео (каждый N-й кадр)
FRAME_STEP=30

# Шаг кадров для режима дрона (чаще, т.к. объекты мельче)
DRONE_FRAME_STEP=15

# ── NVIDIA API (слой 4: облачная проверка подозрительных кропов) ──
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=ВСТАВЬТЕ_ВАШ_КЛЮЧ

# Модель vision для анализа кропов (OpenAI-совместимый формат)
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct

# Задержка между запросами (сек) — лимит 40 запросов/мин
NVIDIA_API_DELAY=2.0
